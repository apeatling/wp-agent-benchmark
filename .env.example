# Copy this file to .env and fill in only what you need. .env is gitignored; never commit real keys.
# Run `uv run wpab doctor` afterwards to see which agents you can run.
#
# Each agent signs in automatically: with its maker's API key below if it's set, otherwise with your own
# plan if you're signed in on this machine (Claude: `claude setup-token`; ChatGPT: `codex login`).

# --- The easiest start: one key for five agents ---

# Grok, Kimi, DeepSeek, GLM and Qwen all run through OpenRouter (openrouter.ai). A run costs cents to
# about $0.50 depending on the model.
OPENROUTER_API_KEY=

# --- Other agents ---

# Opus and Sonnet in Claude Code. Either an API key...
ANTHROPIC_API_KEY=
# ...or your Claude plan: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# GPT in Codex. Either an API key, or your ChatGPT plan: run `codex login` (nothing to add here).
OPENAI_API_KEY=

# Gemini in Antigravity (aistudio.google.com).
GEMINI_API_KEY=

# --- Classifying runs (optional) ---

# Jev, from TypeSafe (docs.typesafe.ai). Without it, `wpab classify` uses the claude CLI on your Claude plan.
TYPESAFE_API_KEY=
